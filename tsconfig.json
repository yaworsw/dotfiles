{
  "compilerOptions": {
    "target": "esnext", 
        "module": "esnext",
    "moduleResolution": "node", 
    "esModuleInterop": true, 
    "outDir": "./dist", 
    "forceConsistentCasingInFileNames": true, 
    "skipLibCheck": true, 
    "jsx": "react-jsx" 
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx" 
  ],
  "exclude": [
    "node_modules"
  ]
}